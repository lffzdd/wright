# Secrets go here (~/.wright/.env) or in the real environment.
# Non-secret settings belong in ~/.wright/settings.json; see docs/settings.md.
# A project .env only supplies OPENAI_API_KEY, OPENAI_MODEL, OPENAI_CONTEXT_LIMIT,
# WRIGHT_CONTEXT_LIMITS, OPENAI_MEMORY_MODEL, TAVILY_API_KEY and BRAVE_API_KEY.
# OPENAI_API_KEY goes to llm.base_url when that is set, otherwise to OpenAI.
OPENAI_API_KEY=

# Provider keys for catalog models when llm.base_url is empty. Each key is sent
# only to its own provider; the picker offers models of providers with a key.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# ZAI_API_KEY=

# Web search (web_search tool). The tool is offered to the model only when a
# provider key is set. Without WRIGHT_SEARCH_PROVIDER the first provider with a
# key is used (tavily, then brave). Base URLs are read from ~/.wright/.env only.
# WRIGHT_SEARCH_PROVIDER=tavily   (tools.web_search: auto/tavily/brave/off)
TAVILY_API_KEY=
# TAVILY_BASE_URL=https://api.tavily.com
# BRAVE_BASE_URL=https://api.search.brave.com

# Every setting can still be overridden by its environment variable, e.g.
# OPENAI_BASE_URL=https://api.deepseek.com    (llm.base_url, all models; empty: each catalog model's provider)
# OPENAI_MODEL=                               (llm.model)
# OPENAI_CONTEXT_LIMIT=128000                 (llm.context_limit, all models; 0: catalog, then 128000)
# WRIGHT_CONTEXT_LIMITS=my-model=64000        (llm.context_limits)
# OPENAI_MEMORY_MODEL=                        (llm.memory_model)
# WRIGHT_MODEL_PRICES=kimi-k3=3/15/0.3        (llm.prices, USD per 1M tokens)
# WRIGHT_AUTO_TITLE=0                         (session.auto_title)
# WRIGHT_DISABLED_SKILLS=skill-a,skill-b      (skills.disabled)
# WRIGHT_MEMORY_ENABLED=0                     (memory.enabled)
# WRIGHT_MEMORY_RECALL=0                      (memory.recall)
# WRIGHT_MEMORY_AUTO_EXTRACT=0                (memory.auto_extract)
# WRIGHT_KNOWLEDGE_ENABLED=1                  (knowledge.enabled)
# WRIGHT_RAG_DIR=/path/to/rag_package         (knowledge.rag_dir)
# WRIGHT_KNOWLEDGE_INDEX=/path/to/index.json  (knowledge.index)
# WRIGHT_LOG_LEVEL=WARNING                    (logging.level)
# WRIGHT_TRUST_PROJECT_MCP=1                  (mcp.trust_project)
# WRIGHT_DEFAULT_EXECUTION=sandbox            (sandbox.default_execution: sandbox/host)
# WRIGHT_HOOKS_CONFIG=/path/to/hooks.json     (hooks.config)

# Override the ~/.wright data root (sessions, traces, memory, settings, user skills)
# WRIGHT_HOME=

# Sandboxed Shell network (macOS/Linux) goes through Wright's per-command egress
# proxy with per-host rules. `legacy` restores the all-or-nothing switch.
# WRIGHT_SANDBOX_EGRESS=proxy                 (sandbox.egress)
