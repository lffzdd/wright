OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_CONTEXT_LIMIT=128000

# Optional cheaper models for memory selection / completion verification
# OPENAI_MEMORY_MODEL=
# OPENAI_VERIFIER_MODEL=

# Optional knowledge search (off by default)
# WRIGHT_KNOWLEDGE_ENABLED=1
# WRIGHT_RAG_DIR=/path/to/rag_package
# WRIGHT_KNOWLEDGE_INDEX=/path/to/simple_index.json
