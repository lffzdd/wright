# A project .env only supplies OPENAI_API_KEY, OPENAI_MODEL, OPENAI_CONTEXT_LIMIT,
# OPENAI_MEMORY_MODEL and TAVILY_API_KEY. Everything else, including the endpoint
# below and every WRIGHT_* setting, goes in ~/.wright/.env or the real environment.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_CONTEXT_LIMIT=128000

# Web search (web_search tool)
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# Optional cheaper model for memory selection / extraction
# OPENAI_MEMORY_MODEL=

# Override the ~/.wright data root (sessions, traces, memory, user skills)
# WRIGHT_HOME=

# Optional knowledge search (off by default)
# WRIGHT_KNOWLEDGE_ENABLED=1
# WRIGHT_RAG_DIR=/path/to/rag_package
# WRIGHT_KNOWLEDGE_INDEX=/path/to/simple_index.json

# Diagnostics are written to ~/.wright/logs/wright.log (under WRIGHT_HOME).
# The terminal shows warnings only; set INFO or DEBUG to see more there.
# WRIGHT_LOG_LEVEL=WARNING
