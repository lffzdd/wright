{
  "version": 2,
  "mode": "default",
  "permissions": {
    "allow": [],
    "ask": [
      "shell(rm *)",
      "shell(sudo *)",
      "shell(* sudo *)",
      "shell(*git push*)"
    ],
    "deny": [
      "shell(rm -* /)",
      "shell(rm -* /[*])",
      "shell(rm -* /.)",
      "shell(rm -* /..)",
      "shell(rm -* ~)",
      "shell(rm -* ~/)",
      "shell(rm -* ~[*])",
      "shell(rm -* ~/[*])",
      "shell(rm -* $HOME)",
      "shell(rm -* $HOME/)",
      "shell(rm -* $HOME[*])",
      "shell(rm -* $HOME/[*])",
      "shell(rm /)",
      "shell(rm ~)",
      "shell(rm $HOME)",
      "shell(rmdir /)",
      "shell(rmdir ~)",
      "shell(rmdir $HOME)"
    ]
  }
}
