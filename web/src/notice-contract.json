{
  "description": "Shared snapshot/live notice cases. Event type precedes kind; empty values use fallbacks; folded_count truncates toward zero; params must be an object.",
  "cases": [
    {"name": "failed error", "type": "turn.failed", "payload": {"error": "provider down", "status": "failed"}, "expected": {"text": "Turn failed: provider down", "code": "notice.turn_failed", "params": {"detail": "provider down"}}},
    {"name": "failed status fallback", "type": "turn.failed", "payload": {"status": "timeout"}, "expected": {"text": "Turn failed: timeout", "code": "notice.turn_failed", "params": {"detail": "timeout"}}},
    {"name": "failed empty error", "type": "turn.failed", "payload": {"error": "", "status": "timeout"}, "expected": {"text": "Turn failed: timeout", "code": "notice.turn_failed", "params": {"detail": "timeout"}}},
    {"name": "failed missing detail", "type": "turn.failed", "payload": {}, "expected": {"text": "Turn failed: unknown error", "code": "notice.turn_failed", "params": {"detail": "unknown error"}}},
    {"name": "failed null detail", "type": "turn.failed", "payload": {"error": null, "status": ""}, "expected": {"text": "Turn failed: unknown error", "code": "notice.turn_failed", "params": {"detail": "unknown error"}}},
    {"name": "cancelled overrides kind and code", "type": "turn.cancelled", "payload": {"kind": "context_compact", "code": "custom"}, "expected": {"text": "Turn cancelled.", "code": "notice.turn_cancelled", "params": {}}},
    {"name": "checkpoint error", "type": "system.checkpoint_error", "payload": {"error": "disk full"}, "expected": {"text": "Checkpoint failed: disk full", "code": "notice.checkpoint_failed", "params": {"detail": "disk full"}}},
    {"name": "checkpoint empty error", "type": "system.checkpoint_error", "payload": {"error": ""}, "expected": {"text": "Checkpoint failed: unknown error", "code": "notice.checkpoint_failed", "params": {"detail": "unknown error"}}},
    {"name": "checkpoint missing error", "type": "system.checkpoint_error", "payload": {}, "expected": {"text": "Checkpoint failed: unknown error", "code": "notice.checkpoint_failed", "params": {"detail": "unknown error"}}},
    {"name": "rejected reason", "type": "command.rejected", "payload": {"reason": "closed"}, "expected": {"text": "closed", "code": "", "params": {}}},
    {"name": "rejected empty reason", "type": "command.rejected", "payload": {"reason": ""}, "expected": {"text": "Command rejected", "code": "", "params": {}}},
    {"name": "rejected missing reason", "type": "command.rejected", "payload": {}, "expected": {"text": "Command rejected", "code": "", "params": {}}},
    {"name": "task nested description", "type": "task.updated", "payload": {"task": {"description": "nested"}, "description": "outer"}, "expected": {"text": "nested", "code": "", "params": {}}},
    {"name": "task empty nested description", "type": "task.updated", "payload": {"task": {"description": ""}, "description": "outer"}, "expected": {"text": "outer", "code": "", "params": {}}},
    {"name": "task outer description", "type": "task.updated", "payload": {"description": "outer"}, "expected": {"text": "outer", "code": "", "params": {}}},
    {"name": "task invalid nested value", "type": "task.updated", "payload": {"task": "invalid", "description": "outer"}, "expected": {"text": "outer", "code": "", "params": {}}},
    {"name": "task null nested value", "type": "task.updated", "payload": {"task": null}, "expected": {"text": "Background task updated", "code": "", "params": {}}},
    {"name": "task missing description", "type": "task.updated", "payload": {}, "expected": {"text": "Background task updated", "code": "", "params": {}}},
    {"name": "completion overrides code", "type": "system.notice", "payload": {"kind": "completion_rejected", "text": "ignored", "code": "custom"}, "expected": {"text": "Completion check requested another attempt.", "code": "notice.completion_another", "params": {}}},
    {"name": "context integer", "type": "system.notice", "payload": {"kind": "context_compact", "folded_count": 4}, "expected": {"text": "Context compacted (4 items).", "code": "notice.context_compact", "params": {"count": "4"}}},
    {"name": "context numeric string", "type": "system.notice", "payload": {"kind": "context_compact", "folded_count": "4"}, "expected": {"text": "Context compacted (4 items).", "code": "notice.context_compact", "params": {"count": "4"}}},
    {"name": "context truncates fraction", "type": "system.notice", "payload": {"kind": "context_compact", "folded_count": 3.7}, "expected": {"text": "Context compacted (3 items).", "code": "notice.context_compact", "params": {"count": "3"}}},
    {"name": "context zero", "type": "system.notice", "payload": {"kind": "context_compact", "folded_count": 0}, "expected": {"text": "Context compacted (0 items).", "code": "notice.context_compact", "params": {"count": "0"}}},
    {"name": "context null count", "type": "system.notice", "payload": {"kind": "context_compact", "folded_count": null}, "expected": {"text": "Context compacted (0 items).", "code": "notice.context_compact", "params": {"count": "0"}}},
    {"name": "context missing count", "type": "system.notice", "payload": {"kind": "context_compact"}, "expected": {"text": "Context compacted (0 items).", "code": "notice.context_compact", "params": {"count": "0"}}},
    {"name": "custom display params", "type": "system.notice", "payload": {"text": "你好", "code": "notice.custom", "params": {"name": "世界", "count": 3}}, "expected": {"text": "你好", "code": "notice.custom", "params": {"name": "世界", "count": "3"}}},
    {"name": "custom display missing params", "type": "system.notice", "payload": {"text": "hello", "code": "notice.custom"}, "expected": {"text": "hello", "code": "notice.custom", "params": {}}},
    {"name": "custom display null params", "type": "system.notice", "payload": {"text": "hello", "code": "notice.custom", "params": null}, "expected": {"text": "hello", "code": "notice.custom", "params": {}}},
    {"name": "custom display array params", "type": "system.notice", "payload": {"text": "hello", "code": "notice.custom", "params": ["invalid"]}, "expected": {"text": "hello", "code": "notice.custom", "params": {}}},
    {"name": "empty code", "type": "system.notice", "payload": {"text": "plain", "code": "", "params": {"ignored": "yes"}}, "expected": {"text": "plain", "code": "", "params": {}}},
    {"name": "non-string code", "type": "system.notice", "payload": {"text": "plain", "code": 42}, "expected": {"text": "plain", "code": "", "params": {}}},
    {"name": "plain notice", "type": "system.notice", "payload": {"text": "hello"}, "expected": {"text": "hello", "code": "", "params": {}}},
    {"name": "empty text", "type": "system.notice", "payload": {"text": ""}, "expected": {"text": "System notice", "code": "", "params": {}}},
    {"name": "null text", "type": "system.notice", "payload": {"text": null}, "expected": {"text": "System notice", "code": "", "params": {}}},
    {"name": "unknown notice kind", "type": "system.notice", "payload": {"kind": "other", "text": "hello"}, "expected": {"text": "hello", "code": "", "params": {}}},
    {"name": "missing text", "type": "system.notice", "payload": {}, "expected": {"text": "System notice", "code": "", "params": {}}}
  ]
